{
  "compilerOptions": {
    "allowJs": false,
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"]
  },
  "include": ["scripts", "src", "test", "vitest.config.ts"]
}
