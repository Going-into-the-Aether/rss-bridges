<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.rss-bridges.snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "__REPO_ROOT__/scripts/publish-christadelphian-snapshot.sh"</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RSS_BRIDGES_GIT_WRAPPER</key>
    <string>__GIT_WRAPPER__</string>
    <key>RSS_BRIDGES_COMMIT_WRAPPER</key>
    <string>__COMMIT_WRAPPER__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/rss-bridges-snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/rss-bridges-snapshot.error.log</string>
</dict>
</plist>
