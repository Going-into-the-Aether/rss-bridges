<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.aetheros.rss-bridges-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "__HOME__/Developer/Repositories/Going-into-the-Aether/rss-bridges/scripts/publish-christadelphian-snapshot.sh"</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/Developer/Repositories/Going-into-the-Aether/rss-bridges</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/rss-bridges-snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/rss-bridges-snapshot.error.log</string>
</dict>
</plist>
