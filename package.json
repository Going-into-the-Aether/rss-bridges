{
  "name": "rss-bridges",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build:info": "node scripts/generate-build-info.ts",
    "release:prepare": "node scripts/generate-build-info.ts --strict",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:tidings-reader": "tsx scripts/import-tidings-reader.ts",
    "import:christadelphian-reader": "tsx scripts/import-christadelphian-reader.ts",
    "lint": "eslint .",
    "snapshot:christadelphian": "tsx scripts/snapshot-christadelphian.ts",
    "sync:tidings-authors": "tsx scripts/sync-tidings-authors.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "10.15.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  },
  "dependencies": {
    "entities": "8.0.0",
    "sanitize-html": "^2.18.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "11.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
